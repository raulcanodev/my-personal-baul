# Local values for `next dev`. In production these are Worker secrets:
#   pnpm wrangler secret put BETTER_AUTH_SECRET
# The database is the D1 binding "DB" in wrangler.jsonc (local copy lives in .wrangler/).

# openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Optional. Once the first account exists, new sign-ups need this code (share it with friends).
# Without it, sign-up is closed. In production: pnpm wrangler secret put SIGNUP_CODE
SIGNUP_CODE=""

# Canonical origin: OAuth issuer and MCP resource (production value lives in wrangler.jsonc vars)
BETTER_AUTH_URL="http://localhost:43871"
