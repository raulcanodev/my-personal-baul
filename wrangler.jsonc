{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baul",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baul",
      "database_id": "05b2d68a-b53d-4c4a-a9c0-3b93daf28023",
      "migrations_dir": "drizzle",
    },
  ],
  // Cloudflare creates the DNS record and certificate for it (wins over the `*` CNAME to Vercel)
  "routes": [{ "pattern": "baul.raulcano.dev", "custom_domain": true }],
  // Keep baul.rawraul.workers.dev as a fallback (wrangler turns it off once routes exist)
  "workers_dev": true,
  // Every day at 05:00 UTC: balances and new transactions from Wise/Mercury
  "triggers": { "crons": ["0 5 * * *"] },
  // Canonical origin: OAuth issuer and the MCP resource (https://baul.raulcano.dev/api/mcp)
  "vars": { "BETTER_AUTH_URL": "https://baul.raulcano.dev" },
  "observability": { "enabled": true },
}
