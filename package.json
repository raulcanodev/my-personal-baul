{
  "name": "my-personal-baul",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "dev": "next dev --turbo --port 43871",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "SKIP_ENV_VALIDATION=1 opennextjs-cloudflare build && opennextjs-cloudflare preview --port 43871",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply baul --local",
    "db:migrate:remote": "CI=true wrangler d1 migrations apply baul --remote",
    "user:create": "node scripts/create-user.mjs",
    "deploy": "SKIP_ENV_VALIDATION=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "@shadcn/react": "^0.3.1",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "better-auth": "^1.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.41.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.71.0",
    "next": "^15.2.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.21.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "superjson": "^2.2.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "wrangler": "^4.160.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
